import ApiProvider from "@/utils/api-provider";
import initDatatable from "@/utils/datatable";
import { startLoading, stopLoading } from "@/utils/button-loading";

const PageScript = (function () {
    let datatable;
    let form;
    const modalId = "#hs-{{kebab}}-modal";

    const reloadDatatable = () => {
        if (datatable) {
            datatable.ajax.reload(null, false);
        }
    };

    const openModal = () => {
        if (window.HSOverlay) {
            window.HSOverlay.open(modalId);
        }
    };

    const closeModal = () => {
        if (window.HSOverlay) {
            window.HSOverlay.close(modalId);
        }
    };

    const resetForm = () => {
        if (!form) return;
        form.reset();
        form.dataset.mode = "create";
        delete form.dataset.id;
{{jsReset}}
    };

    const fillForm = (data) => {
        if (!form || !data) return;
{{jsFill}}
    };

    const handleEdit = async (id) => {
        try {
            const response = await ApiProvider.get(route("{{routePrefix}}.show", id));
            const data = response.data ?? response;
            form.dataset.mode = "edit";
            form.dataset.id = id;
            fillForm(data);
            openModal();
        } catch (error) {
            console.error("Fetch data error:", error);
        }
    };

    const handleDelete = (id, name) => {
        const confirmDelete = window.Confirm?.delete
            ? window.Confirm.delete(`Delete ${name}?`)
            : Promise.resolve(confirm(`Are you sure you want to delete ${name}?`));

        confirmDelete.then(async (confirmed) => {
            if (!confirmed) return;
            try {
                await ApiProvider.delete(route("{{routePrefix}}.destroy", id));
                if (window.Toast?.success) {
                    window.Toast.success("Success", "Data deleted successfully");
                }
                reloadDatatable();
            } catch (error) {
                console.error("Delete error:", error);
            }
        });
    };

    const initDataTable = () => {
        datatable = initDatatable({
            table: "#{{routePrefix}}-datatable",
            filterSelector: "#filter-{{routePrefix}}",
            onRowClick: (row) => handleEdit(row.id),
            ajax: {
                url: route("{{routePrefix}}.index"),
                method: "GET",
                dataSrc: "data",
                data: function (d) {
                    const filterEl = document.querySelector("#filter-{{routePrefix}}");
                    if (filterEl) {
                        d.filter = filterEl.value;
                    }
                },
            },
            columns: [
{{jsColumns}}
            ],
            drawCallback: function () {
                if (window.lucide) window.lucide.createIcons();
            },
        });

        // Event delegation for action buttons
        $("#{{routePrefix}}-datatable").on("click", ".btn-edit", function (e) {
            e.stopPropagation();
            const id = $(this).data("id");
            handleEdit(id);
        });

        $("#{{routePrefix}}-datatable").on("click", ".btn-delete", function (e) {
            e.stopPropagation();
            const id = $(this).data("id");
            const name = $(this).data("name");
            handleDelete(id, name);
        });
    };

    const initForm = () => {
        form = document.querySelector("#{{kebab}}-form");
        if (!form) return;

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const submitBtn = form.querySelector('button[type="submit"]');
            startLoading(submitBtn);

            const mode = form.dataset.mode || "create";
            const id = form.dataset.id;
            const formData = new FormData(form);

            const payload = {{jsPayload}};

            try {
                if (mode === "create") {
                    await ApiProvider.post(route("{{routePrefix}}.store"), payload);
                    if (window.Toast?.success) {
                        window.Toast.success("Success", "{{title}} added successfully");
                    }
                } else {
                    await ApiProvider.put(route("{{routePrefix}}.update", id), payload);
                    if (window.Toast?.success) {
                        window.Toast.success("Success", "{{title}} updated successfully");
                    }
                }
                closeModal();
                resetForm();
                reloadDatatable();
            } catch (error) {
                console.error("Submit error:", error);
            } finally {
                stopLoading(submitBtn);
            }
        });

        const btnCreate = document.querySelector("#btn-create-{{kebab}}");
        if (btnCreate) {
            btnCreate.addEventListener("click", () => {
                resetForm();
            });
        }
    };

    return {
        init() {
            initDataTable();
            initForm();
        },
    };
})();

$(function () {
    PageScript.init();
});
