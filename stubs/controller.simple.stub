<?php

namespace App\Http\Controllers;

use App\Http\Requests\{{studly}}\Save{{studly}}Request;
use App\Http\Resources\{{studly}}Resource;
use App\Models\{{studly}};
use App\Repositories\{{studly}}Repository;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Response;

class {{studly}}Controller extends Controller
{
    public function __construct(
        protected {{studly}}Repository ${{camel}}Repository
    ) {}

    public function index()
    {
        $this->authorize('{{permissionKey}}.view');

        if (request()->expectsJson()) {
            $filter = request('filter', 'active');
            $data = $this->{{camel}}Repository->getAll($filter);

            return {{studly}}Resource::collection($data);
        }

        return view('{{viewFolder}}.index');
    }

    public function store(Save{{studly}}Request $request): {{studly}}Resource
    {
        $this->authorize('{{permissionKey}}.create');

        ${{camel}} = {{studly}}::create($request->validated());

        return new {{studly}}Resource(${{camel}});
    }

    public function show({{studly}} ${{camel}}): {{studly}}Resource
    {
        $this->authorize('{{permissionKey}}.view');

        return new {{studly}}Resource(${{camel}});
    }

    public function update(Save{{studly}}Request $request, {{studly}} ${{camel}}): {{studly}}Resource
    {
        $this->authorize('{{permissionKey}}.update');

        ${{camel}}->update($request->validated());

        return new {{studly}}Resource(${{camel}});
    }

    public function destroy({{studly}} ${{camel}}): Response
    {
        $this->authorize('{{permissionKey}}.delete');

        ${{camel}}->delete();

        return response()->noContent();
    }

    public function restore(int $id): JsonResponse
    {
        $this->authorize('{{permissionKey}}.restore');

        ${{camel}} = {{studly}}::onlyTrashed()->findOrFail($id);
        ${{camel}}->restore();

        return response()->json([
            'message' => 'Data successfully restored',
        ]);
    }

    public function forceDelete(int $id): JsonResponse
    {
        $this->authorize('{{permissionKey}}.forceDelete');

        ${{camel}} = {{studly}}::onlyTrashed()->findOrFail($id);
        ${{camel}}->forceDelete();

        return response()->json([
            'message' => 'Data permanently deleted',
        ]);
    }
}
