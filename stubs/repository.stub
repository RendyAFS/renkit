<?php

namespace App\Repositories;

use App\Models\{{studly}};
use Illuminate\Database\Eloquent\Collection;

class {{studly}}Repository
{
    /**
     * Get all records with status filter.
     */
    public function getAll(string $filter = 'active'): Collection
    {
        $query = {{studly}}::query()->orderBy('id', 'desc');

        if ($filter === 'deleted') {
            $query->onlyTrashed();
        } elseif ($filter === 'all') {
            $query->withTrashed();
        }

        return $query->get();
    }

    /**
     * Find a record by ID.
     */
    public function findById(int $id): ?{{studly}}
    {
        return {{studly}}::findOrFail($id);
    }
}
