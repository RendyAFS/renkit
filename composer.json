{
    "name": "rendyafs/renkit",
    "description": "Laravel Development Toolkit & AI-Assisted Module Generator by RendyAFS",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "RendyAFS",
            "homepage": "https://github.com/RendyAFS"
        }
    ],
    "homepage": "https://github.com/RendyAFS/renkit",
    "keywords": [
        "laravel",
        "crud-generator",
        "module-generator",
        "toolkit",
        "rendyafs",
        "renkit"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/filesystem": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "RendyAFS\\RenKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RendyAFS\\RenKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RendyAFS\\RenKit\\RenKitServiceProvider"
            ],
            "aliases": {
                "RenKit": "RendyAFS\\RenKit\\Facades\\RenKit"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
